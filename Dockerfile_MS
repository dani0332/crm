# syntax=docker/dockerfile:1

# -----------------------------------------------------------------------------
# Doppler CLI + token (www) — keep IMCRM_TOKEN only on the last layer here.
# -----------------------------------------------------------------------------
FROM ubuntu:22.04 AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget gpg apt-transport-https ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*
RUN echo "deb [signed-by=/usr/share/keyrings/doppler-archive-keyring.gpg] https://packages.doppler.com/public/cli/deb/debian any-version main" > /etc/apt/sources.list.d/doppler-cli.list \
    && curl -sLf --retry 3 --tlsv1.2 --proto "=https" 'https://packages.doppler.com/public/cli/gpg.DE2A7741A397C129.key' | gpg --dearmor -o /usr/share/keyrings/doppler-archive-keyring.gpg \
    && apt-get update && apt-get install -y --no-install-recommends doppler \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 www && useradd -u 1000 -g www -m -s /bin/bash www
ARG IMCRM_TOKEN
RUN runuser -u www -- doppler configure set token "${IMCRM_TOKEN}"

# -----------------------------------------------------------------------------
# JS deps (cached when package.json / yarn.lock unchanged)
# -----------------------------------------------------------------------------
FROM node:22.12.0 AS frontend
WORKDIR /var/www
COPY package.json yarn.lock ./
RUN --mount=type=cache,target=/root/.cache/yarn \
    yarn install --frozen-lockfile

# -----------------------------------------------------------------------------
# PHP extensions + Composer vendor (cached layers independent of app PHP edits)
# -----------------------------------------------------------------------------
FROM php:8.4-fpm AS build
WORKDIR /app

ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/install-php-extensions
RUN chmod +x /usr/local/bin/install-php-extensions

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    zip \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN install-php-extensions \
    mbstring \
    pdo_mysql \
    zip \
    exif \
    pcntl \
    memcached \
    redis \
    gd \
    mongodb-2.1.0

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/root/.composer/cache \
    composer install --optimize-autoloader --no-dev --no-scripts --no-interaction

COPY . .
RUN --mount=type=cache,target=/root/.composer/cache \
    if [ ! -f .env ]; then cp .env.example .env; fi \
    && php artisan key:generate --force --no-interaction \
    && composer install --no-dev --optimize-autoloader --no-interaction

# -----------------------------------------------------------------------------
# Runtime image
# -----------------------------------------------------------------------------
FROM php:8.4-fpm

# Optional: pin for reproducible builds, e.g. --build-arg NEWRELIC_PHP_TGZ=newrelic-php5-12.7.0.36-linux.tar.gz
# If empty, picks latest glibc tarball from the release index (same idea as wget -A 'newrelic-php5-*-linux.tar.gz').
ARG NEWRELIC_PHP_TGZ=

COPY --from=dependencies --chown=1000:1000 /home/www/.doppler/ /home/www/.doppler/
COPY --from=dependencies /usr/bin/doppler /usr/bin/doppler

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    sudo \
    libcap2-bin \
    curl \
    wget \
    ca-certificates \
    libfreetype6 \
    libjpeg62-turbo \
    libpng16-16 \
    libzip-dev \
    zlib1g \
    libicu-dev \
    libmemcached11 \
    libwebp-dev \
    libavif16 \
    libsnappy1v5 \
    qpdf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www

RUN groupadd -g 1000 www && \
    useradd -u 1000 -ms /bin/bash -g www www

RUN mkdir /var/log/php && \
    touch /var/log/php/errors.log && \
    touch /var/log/php/www-access.log && \
    touch /var/log/php/www-error.log && \
    touch /var/log/php/www-slow.log && \
    touch /var/log/php/supervisord.log && \
    chmod -R 777 /var/log/php

EXPOSE 80
EXPOSE 443

COPY --from=build /app /var/www/
COPY --from=frontend /var/www/node_modules /var/www/node_modules
COPY --from=build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=build /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

RUN chmod -R ugo+w /var/www/storage

RUN cp docker/supervisor.conf /etc/supervisord.conf && \
    cp docker/blanka.ini /usr/local/etc/php/conf.d/app.ini && \
    cp docker/nginx.conf /etc/nginx/sites-enabled/default && \
    cp -r docker/*.pem /etc/nginx/conf.d/ && \
    cp docker/www.conf /usr/local/etc/php-fpm.d/www.conf

RUN chmod +x /var/www/docker/run.sh

RUN set -eu; \
    NR_TGZ="${NEWRELIC_PHP_TGZ}"; \
    if [ -z "$$NR_TGZ" ]; then \
        NR_TGZ=$$(curl -fsSL https://download.newrelic.com/php_agent/release/ \
            | grep -oE 'newrelic-php5-[0-9A-Za-z._+-]+-linux\.tar\.gz' \
            | grep -vF -- '-linux-musl' \
            | sort -uV | tail -n1); \
    fi; \
    test -n "$$NR_TGZ"; \
    echo "New Relic PHP tarball: $${NR_TGZ}"; \
    curl -fsSL "https://download.newrelic.com/php_agent/release/$${NR_TGZ}" -o /tmp/nr.tgz \
    && tar -xzf /tmp/nr.tgz -C /tmp \
    && export NR_INSTALL_USE_CP_NOT_LN=1 NR_INSTALL_SILENT=1 \
    && /tmp/newrelic-php5-*/newrelic-install install \
    && rm -rf /tmp/nr.tgz /tmp/newrelic-php5-* /tmp/nrinstall* \
    && sed -i \
        -e 's/"REPLACE_WITH_REAL_KEY"/"${NEW_RELIC_LICENSE_KEY}"/' \
        -e 's/newrelic.appname = "PHP Application"/newrelic.appname = "${NEW_RELIC_APP_NAME}"/' \
        -e 's/;newrelic.daemon.app_connect_timeout =.*/newrelic.daemon.app_connect_timeout=15s/' \
        -e 's/;newrelic.daemon.start_timeout =.*/newrelic.daemon.start_timeout=5s/' \
        -e 's|^;\?newrelic\.daemon\.logfile = .*|newrelic.daemon.logfile = "/var/log/php/newrelic-daemon.log"|' \
        -e 's|^;\?newrelic\.logfile = .*|newrelic.logfile = "/var/log/php/newrelic-php_agent.log"|' \
        /usr/local/etc/php/conf.d/newrelic.ini

RUN sed -i 's|pidfile=/var/run/supervisord.pid|pidfile=/tmp/supervisord.pid|' /etc/supervisord.conf \
    && sed -i 's|logfile=/var/log/supervisord.log|logfile=/var/log/php/supervisord.log|' /etc/supervisord.conf \
    && sed -i '/^\[program:fix_permissions\]/,$s/^autostart=true$/autostart=false/' /etc/supervisord.conf \
    && setcap 'cap_net_bind_service=+ep' /usr/sbin/nginx \
    && printf '%s\n' 'www ALL=(root) NOPASSWD: /bin/chown, /bin/chmod, /bin/mkdir' > /etc/sudoers.d/www \
    && chmod 0440 /etc/sudoers.d/www \
    && visudo -cf /etc/sudoers.d/www \
    && mkdir -p /var/log/newrelic \
    && chown -R www:www /var/www /var/log/nginx /var/log/php /var/log/newrelic /home/www/.doppler

ENV HOME=/home/www

USER www

ENTRYPOINT ["/var/www/docker/run.sh"]
