/**
 * Cursor AI Rules for Car AIG Workflows
 * 
 * This rule file enforces business logic and patterns related to Car AIG insurance processes.
 * It monitors code changes that might affect the integrity of AIG-specific workflows,
 * data models, and integrations.
 */

// ----------------------------------------------------------------------------------
// Car AIG Lead Identification and Tagging Rules
// ----------------------------------------------------------------------------------

// Ensure proper usage of AIG tag for car quotes
rule EnforceCarAIGTagging {
  matches: file(app/Traits/QuoteTraits/QuoteAllocatable.php)
  
  // Preserve the AIG tag check function
  detects: any(
    removal('public function isAIG(QuoteTypes $quoteType): bool'),
    change('return QuoteTag::where(\'quote_uuid\', $this->uuid)->where(\'quote_tags.name\', QuoteSegmentEnum::AIG->tag())->where(\'quote_tags.quote_type_id\', $quoteType->id())->exists();')
  )
  
  warns: "The AIG tag identification logic has been modified. Ensure Car AIG leads can still be properly identified."
}

// Ensure AIG lead query scopes remain intact
rule PreserveAIGQueryScopes {
  matches: file(app/Traits/QuoteTraits/QuoteAllocatable.php)
  
  detects: any(
    removal('protected function scopeIsAIG($query, QuoteTypes $quoteType): void'),
    removal('protected function scopeIsNotAIG($query, QuoteTypes $quoteType): void'),
    removal('protected function aigSubQuery($subQuery, $table, QuoteTypes $quoteType)')
  )
  
  errors: "Critical AIG query scope methods have been removed or modified. These methods are essential for identifying AIG leads."
}

// ----------------------------------------------------------------------------------
// Car AIG Workflow Job Rules
// ----------------------------------------------------------------------------------

// Monitor changes to the AIG Workflow Job
rule PreserveAIGWorkflowJobLogic {
  matches: file(app/Jobs/AIGWorkflowJob.php)
  
  detects: any(
    change(method('handle')),
    removal('$carEmailService->sendAIGWorkflow($quote);')
  )
  
  warns: "The AIGWorkflowJob handle method has been modified. Ensure the core Car AIG workflow dispatch logic is preserved."
}

// Ensure job configuration remains correct
rule AIGJobConfigurationCheck {
  matches: file(app/Jobs/AIGWorkflowJob.php)
  
  detects: any(
    change('public $tries = 3;'),
    change('public $timeout = 15;'),
    change('public $backoff = 60;')
  )
  
  warns: "AIGWorkflowJob execution parameters (tries, timeout, backoff) have been modified. This may affect job reliability."
}

// ----------------------------------------------------------------------------------
// Car AIG Email Service Rules
// ----------------------------------------------------------------------------------

// Protect the Car AIG workflow execution logic
rule PreserveCarAIGWorkflowExecution {
  matches: file(app/Services/EmailServices/CarEmailService.php)
  
  detects: any(
    removal('public function sendAIGWorkflow($lead)'),
    change('$lead->aig_flow_executed_at = now();'),
    removal('$emailData = $this->buildAIGWorkflowData($lead, $advisor, WorkflowTypeEnum::AIG_WORKFLOW);')
  )
  
  errors: "Critical Car AIG workflow logic in CarEmailService has been modified. This affects workflow triggering and execution tracking."
}

// Ensure AIG workflow data payload remains complete
rule EnsureAIGWorkflowDataIntegrity {
  matches: file(app/Services/EmailServices/CarEmailService.php)
  
  detects: removal(method('buildAIGWorkflowData'))
  
  errors: "The Car AIG workflow data builder has been removed. This function is essential for creating the correct Bird API payload."
}

// ----------------------------------------------------------------------------------
// Car AIG API Endpoint Rules
// ----------------------------------------------------------------------------------

// Protect the AIG workflow trigger API endpoint
rule PreserveAIGWorkflowAPIEndpoint {
  matches: file(routes/api.php)
  
  detects: removal("Route::post('/imcrm/trigger-aig-workflow', [ApiController::class, 'triggerAIGWorkflow'])->name('triggerAIGWorkflow');")
  
  errors: "The API endpoint for triggering AIG workflows has been removed. This endpoint is required for external systems to initiate Car AIG workflows."
}

// Ensure API controller maintains the AIG workflow trigger method
rule PreserveAIGAPIControllerMethod {
  matches: file(app/Http/Controllers/API/ApiController.php)
  
  detects: removal('public function triggerAIGWorkflow(AIGWorkflowRequest $request)')
  
  errors: "The triggerAIGWorkflow controller method has been removed. This method is required to handle AIG workflow API requests."
}

// Monitor changes to the API service Car AIG workflow logic
rule PreserveAPIServiceAIGWorkflow {
  matches: file(app/Services/ApiService.php)
  
  detects: any(
    removal(method('triggerAIGWorkflow')),
    removal('dispatch(new AIGWorkflowJob($quoteUuid, $quoteTypeId));')
  )
  
  errors: "The ApiService triggerAIGWorkflow method has been modified. This affects the core Car AIG workflow trigger logic."
}

// ----------------------------------------------------------------------------------
// Bird Integration Rules for Car AIG
// ----------------------------------------------------------------------------------

// Monitor Bird service webhook request logic
rule PreserveBirdWebhookIntegration {
  matches: file(app/Services/BirdService.php)
  
  detects: change(method('triggerWebHookRequest'))
  
  warns: "The Bird API webhook request method has been modified. This may affect Car AIG communication workflows."
}

// Ensure Car AIG Bird workflow configuration is maintained
rule PreserveBirdWorkflowConfiguration {
  matches: file(app/Enums/ApplicationStorageEnums.php)
  
  detects: removal('public const BIRD_NB_MOTOR_WORKFLOW = \'BIRD_NB_MOTOR_WORKFLOW\';')
  
  errors: "The Bird workflow configuration constant for Car AIG has been removed. This constant is required for workflow triggering."
}

// ----------------------------------------------------------------------------------
// Car AIG Database Structure Rules
// ----------------------------------------------------------------------------------

// Ensure CarQuote model preserves AIG fields
rule PreserveCarQuoteAIGFields {
  matches: file(app/Models/CarQuote.php)
  
  detects: any(
    removal('aig_flow_executed_at')
  )
  
  errors: "The aig_flow_executed_at field in the CarQuote model has been removed. This field is essential for tracking Car AIG workflow execution status."
}

// ----------------------------------------------------------------------------------
// Allocation and Processing Rules for Car AIG
// ----------------------------------------------------------------------------------

// Ensure Car AIG lead allocation logic is preserved
rule PreserveAIGAllocationLogic {
  matches: file(app/Strategies/Allocations/CarAllocation.php)
  
  detects: removal(method('isAIGLeadEligibleForAllocation'))
  
  warns: "The Car AIG allocation eligibility method has been removed. This affects how AIG leads are allocated to advisors."
}

// Monitor changes to AIG workflow types
rule PreserveWorkflowTypeDefinitions {
  matches: file(app/Enums/WorkflowTypeEnum.php)
  
  detects: removal('public const AIG_WORKFLOW = \'aig_workflow\';')
  
  errors: "The AIG_WORKFLOW type constant has been removed. This constant is required to identify Car AIG workflows."
}

// ----------------------------------------------------------------------------------
// Security and Validation Rules
// ----------------------------------------------------------------------------------

// Ensure AIG workflow request validation remains secure
rule PreserveAIGRequestValidation {
  matches: file(app/Http/Requests/AIGWorkflowRequest.php)
  
  detects: any(
    change(method('rules')),
    change('return true;') in method('authorize')
  )
  
  warns: "The validation or authorization logic for Car AIG workflow requests has been modified. Ensure proper security controls remain in place."
}

// ----------------------------------------------------------------------------------
// ENHANCED RULES FOR BETTER COVERAGE
// ----------------------------------------------------------------------------------

// Monitor changes to helper methods or related utility functions used in Car AIG tagging and validation
rule MonitorHelperMethodsChanges {
  matches: any(
    file(app/Helpers/CarAIGHelper.php),
    file(app/Services/Helpers/AIGHelper.php)
  )
  detects: any(
    removal(method('validateAIGTag')),
    change(method('buildCarAIGPayload'))
  )
  warns: "Potential changes in helper functions related to Car AIG tagging or payload building detected. Review for business logic impact."
}

// Track removal or modification of test files for Car AIG workflows
rule PreserveCarAIGTests {
  matches: file(tests/Feature/CarAIG/)
  
  detects: removal(any)
  
  warns: "Car AIG feature tests have been removed or modified. Ensure test coverage is sufficient."
}

// Watch for changes in configuration files or environment variable keys related to Car AIG
rule MonitorCarAIGConfigChanges {
  matches: any(
    file(config('aig.php')),
    file('.env')
  )
  
  detects: any(
    change('BIRD_NB_MOTOR_WORKFLOW'),
    removal('BIRD_NB_MOTOR_WORKFLOW'),
    change('ECOM_CAR_INSURANCE_QUOTE_URL')
  )
  
  warns: "Configuration keys related to Car AIG workflows have changed. Verify that integrations and URLs remain valid."
}

// Add contextual alerts with impact details
rule ContextualAlertOnJobHandleChange {
  matches: file(app/Jobs/AIGWorkflowJob.php)
  
  detects: change(method('handle'))
  
  warns: "Changes to AIGWorkflowJob::handle may affect the orchestration of Car AIG quote workflows, including job dispatch and external API calls."
}

// Monitor business logic inside critical methods, not just their presence
rule MonitorBusinessLogicChangesInCarEmailService {
  matches: file(app/Services/EmailServices/CarEmailService.php)
  
  detects: change(method('sendAIGWorkflow'))
  
  warns: "Modifications detected inside sendAIGWorkflow method. Ensure that workflow data building, state updates, and external calls remain consistent."
}

// Monitor changes to QuoteFlow details creation for tracking
rule EnsureQuoteFlowDetailsCreation {
  matches: file(app/Services/EmailServices/CarEmailService.php)
  
  detects: removal('$this->createQuoteFlowDetails($lead, $response);')
  
  warns: "The creation of quote flow details for Car AIG workflows has been removed. This affects workflow tracking and reporting."
}

// Track changes to AIG tag implementations across the codebase
rule TrackAIGTagUsageAcrossCodebase {
  matches: any(file(/.*\.php/))
  
  detects: any(
    change(/QuoteSegmentEnum::AIG->tag\(\)/),
    removal(/QuoteSegmentEnum::AIG->tag\(\)/)
  )
  
  warns: "Changes detected in references to AIG tag usage. This may affect lead identification and processing throughout the system."
}

// Ensure that error handling for AIG workflows remains intact
rule PreserveAIGErrorHandling {
  matches: file(app/Services/EmailServices/CarEmailService.php)
  
  detects: any(
    removal(/catch \(.*\)/),
    removal(/LoggerService::error\(/),
    removal(/AIGWorkflow-Error/)
  )
  
  warns: "Error handling for Car AIG workflows has been modified. This may affect system stability and error reporting."
} 