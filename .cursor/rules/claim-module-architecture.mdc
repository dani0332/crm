### 6. Vue.js Component Patterns

```vue
<script setup>
const props = defineProps({
  data: Object,
  dropdowns: Object,
});

const emit = defineEmits(['update']);

const page = usePage();
const can = permission => useCan(permission);
const permissionsEnum = page.props.permissionsEnum;
const notification = useToast();
const { isRequired, maxCharacters, isValidEmail } = useRules();

const form = useForm({
  name: props.data?.name || '',
  email: props.data?.email || '',
  status_id: props.data?.status_id || '',
});

const statusOptions = computed(() => {
  return props.dropdowns?.statuses?.map(status => ({
    value: status.id,
    label: status.text,
  })) || [];
});

const updateData = (isValid) => {
  if (!isValid) return;

  form
    .transform(data => ({
      ...data,
      name: data.name ? data.name.trim() : null,
      email: data.email ? data.email.trim().toLowerCase() : null,
    }))
    .post(route('example.update', props.data?.uuid), {
      preserveScroll: true,
      onSuccess: response => {
        emit('update', response);
        notification.success({
          title: 'Updated successfully',
          position: 'top',
        });
      },
      onError: errors => {
        Object.keys(errors).forEach(key => {
          notification.error({
            title: errors[key],
            position: 'top',
          });
        });
      },
    });
};

// Custom validation that mirrors backend
const validateForm = () => {
  const errors = {};

  if (!form.name?.trim()) {
    errors.name = 'Name is required.';
  } else if (!/^[a-zA-Z\s\'-\.]+$/.test(form.name)) {
    errors.name = 'Name contains invalid characters.';
  }

  if (!form.email?.trim()) {
    errors.email = 'Email is required.';
  } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email)) {
    errors.email = 'Email format is invalid.';
  }

  // Set errors on form
  Object.keys(errors).forEach(key => {
    form.errors[key] = errors[key];
  });

  return Object.keys(errors).length === 0;
};
</script>

<template>
  <div class="p-4 rounded shadow my-6 bg-white">
    <Collapsible :expanded="true">
      <template #header>
        <h3 class="font-semibold text-primary-800 text-lg">Details</h3>
      </template>
      <template #body>
        <x-form :form="form" @submit="updateData">
          <div class="grid md:grid-cols-2 gap-4">
            <x-input
              v-model="form.name"
              label="Name"
              :error="form.errors.name"
              :rules="[isRequired, maxCharacters(255)]"
              required
            />

            <x-input
              v-model="form.email"
              label="Email"
              type="email"
              :error="form.errors.email"
              :rules="[isRequired, isValidEmail]"
              required
            />

            <x-select
              v-model="form.status_id"
              label="Status"
              :options="statusOptions"
              :error="form.errors.status_id"
              :rules="[isRequired]"
              required
            />
          </div>

          <div class="flex justify-end mt-4">
            <x-button
              v-if="can(permissionsEnum.EXAMPLE_EDIT)"
              type="submit"
              color="emerald"
              :loading="form.processing"
            >
              Update
            </x-button>
          </div>
        </x-form>
      </template>
    </Collapsible>
  </div>
</template>
```

## Key Requirements

### Security Implementation
- Always use `PermissionsEnum` constants for middleware
- Implement `useCan()` permission checks in Vue components
- Sanitize all inputs in `prepareForValidation()`
- Use UUID-based routing for enhanced security
- Log all validation failures and user actions

### Error Handling & Logging
- Use `LoggerService` for structured logging with context
- Implement try-catch blocks in all controller methods
- Provide user-friendly error messages
- Log user ID and relevant entity IDs in all entries

### Performance Optimization
- Use eager loading with specific field selection
- Implement pagination with `simplePaginate()`
- Apply proper database indexing
- Use caching strategies for dropdown data

### Laravel 12 Compatibility
- Use strict typing: `declare(strict_types=1)` in all files
- Apply typed properties and method signatures
- Use PHP 8.2+ features (readonly properties, match expressions)
- Implement proper nullable and union types
- name each route on creation and use route by name.

### Testing Strategy
- Write Feature tests for controller endpoints
- Test permission-based access control
- Use Unit tests for service layer methods
- Mock external dependencies and APIs

