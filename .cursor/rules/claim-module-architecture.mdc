namespace App\Observers;

use App\Models\ExampleModel;
use App\Services\Logger\LoggerService;

class ExampleModelObserver
{
    public function updating(ExampleModel $model): void
    {
        if ($model->isDirty('status_id')) {
            $originalStatus = $model->getOriginal('status_id');
            $newStatus = $model->status_id;

            LoggerService::info('Status change detected', extra: [
                'model_id' => $model->id,
                'original_status' => $originalStatus,
                'new_status' => $newStatus,
                'user_id' => auth()->id(),
            ]);
        }
    }

    public function updated(ExampleModel $model): void
    {
        if ($model->isDirty('status_id')) {
