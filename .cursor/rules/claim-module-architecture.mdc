# Comprehensive Laravel-Vue Claim Module Architecture Patterns

You are an expert in Laravel, Vue.js, and modern full-stack web development technologies following the patterns established in this codebase's claim module.

## Core Architecture Principles

Follow these established patterns from the claim module analysis:

### 1. Controller Structure

```php
<?php

declare(strict_types=1);

namespace App\Http\Controllers;

use App\Enums\PermissionsEnum;
use App\Services\ClaimsService;
use App\Services\Logger\LoggerService;
use Exception;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

class ExampleController extends Controller
{
    protected ExampleService $exampleService;

    public function __construct(ExampleService $exampleService)
    {
        $this->exampleService = $exampleService;
        $this->middleware(['permission:'.PermissionsEnum::EXAMPLE_LIST], ['only' => ['index']]);
        $this->middleware(['permission:'.PermissionsEnum::EXAMPLE_CREATE], ['only' => ['create', 'store']]);
        $this->middleware(['permission:'.PermissionsEnum::EXAMPLE_EDIT], ['only' => ['edit', 'update']]);
        $this->middleware(['permission:'.PermissionsEnum::EXAMPLE_SHOW], ['only' => ['show']]);
    }

    public function index(Request $request): Response
    {
        try {
            $data = $this->exampleService->getData($request);
            $dropdownOptions = $this->exampleService->getDropdownData();

            return Inertia::render('Example/Index', [
                'data' => $data,
                'dropdownOptions' => $dropdownOptions,
            ]);
        } catch (Exception $e) {
            LoggerService::error(self::class.'::'.__FUNCTION__.' - Error loading data', extra: [
                'error' => $e->getMessage(),
                'user_id' => auth()->id(),
            ]);

            return redirect()->back()->with('error', 'Failed to load data.');
        }
    }

    public function store(ExampleStoreRequest $request): RedirectResponse
    {
        try {
            $result = $this->exampleService->create($request->validated());

            if (!empty($result->errors)) {
                vAbort($result->errors);
            }

            return redirect()->route('example.show', $result->uuid)
                ->with('success', "Record {$result->code} has been created successfully.");
        } catch (Exception $e) {
            LoggerService::error(self::class.'::'.__FUNCTION__.' - Error creating record', extra: [
                'error' => $e->getMessage(),
                'data' => $request->validated(),
                'user_id' => auth()->id(),
            ]);

            return redirect()->back()->with('error', 'Failed to create record.');
        }
    }
}
```

### 2. Service Layer Implementation

```php
<?php

declare(strict_types=1);

namespace App\Services;

use App\Traits\CentralTrait;
use Illuminate\Http\Request;

class ExampleService extends BaseService
{
    use CentralTrait;

    protected string $searchPrefix = 'examples.';
    protected $query;
    protected int $perPage = 15;

    public function __construct()
    {
        parent::__construct();

        $this->query = ExampleModel::select([
            'id',
            'uuid',
            'name',
            'status_id',
            'created_at',
        ])->with([
            'status:id,text',
            'createdBy:id,name',
        ]);
    }

    public function getData(Request $request)
    {
        $filters = $this->getFilters($request);
        $query = $this->applyFilters($this->query, $filters);

        return $query->simplePaginate($this->perPage)->withQueryString();
    }

    public function applyFilters($query, $filters)
    {
        if (!empty($filters['name'])) {
            $query->where('name', 'like', '%'.$filters['name'].'%');
        }

        if (!empty($filters['status_id'])) {
            $query->where('status_id', $filters['status_id']);
        }

        return $query;
    }

    public function getFilters(Request $request): array
    {
        return $request->only([
            'name',
            'status_id',
            'created_at_start',
            'created_at_end',
        ]);
    }
}
```

### 3. Request Validation Patterns

```php
<?php

declare(strict_types=1);

namespace App\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Support\Facades\Auth;

class ExampleStoreRequest extends FormRequest
{
    public function authorize(): bool
    {
        return true;
    }

    public function rules(): array
    {
        return [
            'name' => [
                'required',
                'string',
                'max:255',
                'regex:/^[a-zA-Z\s\'-\.]+$/',
            ],
            'email' => [
                'required',
                'email:rfc,dns',
                'max:255',
            ],
            'status_id' => [
                'required',
                'integer',
                'exists:statuses,id',
            ],
        ];
    }

    public function messages(): array
    {
        return [
            'name.required' => 'Name is required.',
            'name.regex' => 'Name contains invalid characters.',
            'email.required' => 'Email address is required.',
            'email.email' => 'Email address must be in a valid format.',
        ];
    }

    public function attributes(): array
    {
        return [
            'name' => 'name',
            'email' => 'email address',
        ];
    }

    protected function prepareForValidation(): void
    {
        $this->merge([
            'name' => $this->name ? trim($this->name) : null,
            'email' => $this->email ? trim(strtolower($this->email)) : null,
        ]);
    }

    public function withValidator($validator): void
    {
        $validator->after(function ($validator) {
            // Custom validation logic
            if ($this->someCondition()) {
                $validator->errors()->add('field', 'Custom validation message.');
            }
        });
    }

    protected function failedValidation(\Illuminate\Contracts\Validation\Validator $validator)
    {
        $errors = $validator->errors();

        \App\Services\Logger\LoggerService::info('Validation failed', extra: [
            'errors' => $errors->toArray(),
            'input' => $this->except(['password']),
            'user_id' => Auth::id(),
        ]);

        parent::failedValidation($validator);
    }
}
```

### 4. Model Security & Features

```php
<?php

declare(strict_types=1);

namespace App\Models;

use App\Enums\FilterTypes;
use App\Traits\FilterCriteria;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\Eloquent\Relations\MorphMany;
use Illuminate\Database\Eloquent\SoftDeletes;
use Illuminate\Support\Facades\Auth;
use OwenIt\Auditing\Auditable;
use OwenIt\Auditing\Contracts\Auditable as AuditableContract;

class ExampleModel extends Model implements AuditableContract
{
    use Auditable, FilterCriteria, HasFactory, SoftDeletes;

    protected $table = 'examples';

    protected $fillable = [
        'name',
        'email',
        'status_id',
        'created_by_id',
        'updated_by_id',
    ];

    protected $casts = [
        'created_at' => 'datetime',
        'updated_at' => 'datetime',
        'deleted_at' => 'datetime',
    ];

    public $filterables = [
        'name' => FilterTypes::LIKE,
        'email' => FilterTypes::EXACT,
        'status_id' => FilterTypes::IN,
        'created_at' => FilterTypes::DATE_BETWEEN,
    ];

    public static function boot()
    {
        parent::boot();

        static::creating(function ($model) {
            $model->created_by_id = Auth::id();
        });

        static::updating(function ($model) {
            $model->updated_by_id = Auth::id();
        });
    }

    // Relationships
    public function createdBy(): BelongsTo
    {
        return $this->belongsTo(User::class, 'created_by_id');
    }

    public function updatedBy(): BelongsTo
    {
        return $this->belongsTo(User::class, 'updated_by_id');
    }

    public function status(): BelongsTo
    {
        return $this->belongsTo(Status::class, 'status_id');
    }

    public function documents(): MorphMany
    {
        return $this->morphMany(QuoteDocument::class, 'quote_documentable');
    }

    // Scopes
    public function scopeActive($query)
    {
        return $query->whereHas('status', function ($q) {
            $q->where('is_active', true);
        });
    }

    public function scopeByUser($query, $userId)
    {
        return $query->where('created_by_id', $userId);
    }
}
```

### 5. Observer Pattern Implementation

