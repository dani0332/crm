{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "azure-oss/storage-blob-laravel": "^1.0",
    "baopham/dynamodb": "^6.4",
    "barryvdh/laravel-dompdf": "^2.0",
    "bensampo/laravel-enum": "^v6.6.3",
    "doctrine/dbal": "^3.3",
    "filippo-toso/pdf-watermarker": "^1.1",
    "guzzlehttp/guzzle": "^7.4",
    "hidehalo/nanoid-php": "^1.1",
    "illuminate/contracts": "^11.0",
    "illuminate/support": "^11.0",
    "inertiajs/inertia-laravel": "^1.0",
    "intervention/image": "^3.7",
    "jjaffeux/postmark-inbound-php": ">=3.0",
    "laravel/framework": "^11.0",
    "laravel/horizon": "^5.29",
    "laravel/sanctum": "^4.0",
    "laravel/socialite": "^5.2",
    "laravel/telescope": "^5.0",
    "laravel/tinker": "^2.5",
    "league/flysystem-aws-s3-v3": "^3.0",
    "maatwebsite/excel": "^3.1",
    "mongodb/laravel-mongodb": "^5.1",
    "owen-it/laravel-auditing": "^13.0",
    "parsecsv/php-parsecsv": "^1.3",
    "phpoffice/phpword": "^1.2",
    "predis/predis": "^2.2",
    "pusher/pusher-php-server": "^7.2",
    "sammyjo20/laravel-haystack": "^2.2.0",
    "sentry/sentry-laravel": "^4.4.1",
    "setasign/fpdi": "^2.6",
    "spatie/laravel-fractal": "^6.0.3",
    "spatie/laravel-navigation": "^1.2",
    "spatie/laravel-permission": "^6.4.0",
    "tightenco/ziggy": "^2.0",
    "tecnickcom/tcpdf": "^6.7"
  },
  "require-dev": {
    "spatie/laravel-ignition": "^2.3",
    "fakerphp/faker": "^1.9.1",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.6",
    "laravel/ui": "^4.2.2",
    "mockery/mockery": "^1.4.2",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.1.2"
  },
  "autoload": {
    "files": [
      "app/helpers/Helper.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "serve": "composer install && doppler run -- php artisan serve",
    "pint:fix": "vendor/bin/pint"
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    },
    "hooks": {
      "pre-commit": [
        "vendor/bin/pint"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
