{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "azure-oss/storage-blob-laravel": "^1.0",
    "baopham/dynamodb": "^7.1",
    "barryvdh/laravel-dompdf": "^3.1",
    "bensampo/laravel-enum": "^v6.6.3",
    "doctrine/dbal": "^4.3",
    "guzzlehttp/guzzle": "^7.4",
    "hidehalo/nanoid-php": "^1.1",
    "inertiajs/inertia-laravel": "^2.0",
    "intervention/image": "^3.7",
    "jjaffeux/postmark-inbound-php": ">=3.0",
    "lab404/laravel-impersonate": "^1.7",
    "laravel/framework": "^13.0",
    "laravel/horizon": "^5.29",
    "laravel/sanctum": "^4.0",
    "laravel/socialite": "^5.2",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "maatwebsite/excel": "^3.1",
    "mongodb/laravel-mongodb": "^5.7",
    "owen-it/laravel-auditing": "^14.0",
    "parsecsv/php-parsecsv": "^1.3",
    "phpoffice/phpword": "^1.2",
    "predis/predis": "^2.2",
    "pusher/pusher-php-server": "^7.2",
    "sentry/sentry-laravel": "^4.4.1",
    "setasign/fpdf": "^1.8",
    "setasign/fpdi": "^2.6",
    "spatie/laravel-activitylog": "^4.0",
    "spatie/laravel-navigation": "^1.2",
    "spatie/laravel-permission": "^6.4.0",
    "staudenmeir/laravel-cte": "^1.13",
    "tightenco/ziggy": "^2.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9.1",
    "laravel/boost": "^2.0",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.6",
    "laravel/ui": "^4.2.2",
    "mockery/mockery": "^1.4.2",
    "nunomaduro/collision": "^8.1",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpunit/phpunit": "^12.0",
    "spatie/laravel-ignition": "^2.3"
  },
  "autoload": {
    "files": [
      "app/helpers/Helper.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan boost:update --ansi"
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "serve": "composer install && doppler run -- php artisan serve",
    "pint:fix": "vendor/bin/pint",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "vendor/bin/pest"
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    },
    "platform": {
      "ext-mongodb": "2.1.0"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
